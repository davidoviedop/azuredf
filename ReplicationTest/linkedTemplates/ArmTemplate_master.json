{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "ReplicationTest"
		},
		"FacilTEST_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'FacilTEST'"
		},
		"AzureKeyVault1_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://faciltest.vault.azure.net/"
		},
		"FacilERP_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "camos.facilsoft.pe,49301"
		},
		"FacilERP_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "FacilERP"
		},
		"FacilERP_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "admfs"
		},
		"FacilREP_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "faciltest.database.windows.net"
		},
		"FacilREP_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "FacilREP"
		},
		"FacilREP_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "admfs"
		},
		"FacilTEST_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "faciltest.database.windows.net"
		},
		"FacilTEST_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "FacilTEST"
		},
		"FacilTEST_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "admfs"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "ReplicationTest_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"FacilTEST_password": {
						"value": "[parameters('FacilTEST_password')]"
					},
					"AzureKeyVault1_properties_typeProperties_baseUrl": {
						"value": "[parameters('AzureKeyVault1_properties_typeProperties_baseUrl')]"
					},
					"FacilTEST_properties_typeProperties_server": {
						"value": "[parameters('FacilTEST_properties_typeProperties_server')]"
					},
					"FacilTEST_properties_typeProperties_database": {
						"value": "[parameters('FacilTEST_properties_typeProperties_database')]"
					},
					"FacilTEST_properties_typeProperties_userName": {
						"value": "[parameters('FacilTEST_properties_typeProperties_userName')]"
					},
					"FacilERP_properties_typeProperties_server": {
						"value": "[parameters('FacilERP_properties_typeProperties_server')]"
					},
					"FacilERP_properties_typeProperties_database": {
						"value": "[parameters('FacilERP_properties_typeProperties_database')]"
					},
					"FacilERP_properties_typeProperties_userName": {
						"value": "[parameters('FacilERP_properties_typeProperties_userName')]"
					},
					"FacilREP_properties_typeProperties_server": {
						"value": "[parameters('FacilREP_properties_typeProperties_server')]"
					},
					"FacilREP_properties_typeProperties_database": {
						"value": "[parameters('FacilREP_properties_typeProperties_database')]"
					},
					"FacilREP_properties_typeProperties_userName": {
						"value": "[parameters('FacilREP_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}