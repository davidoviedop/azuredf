{
	"name": "Migrar",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "VariedadesERP",
						"type": "DatasetReference"
					},
					"name": "Variedades"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "FacilTEST",
						"type": "DatasetReference"
					},
					"name": "MigrarDatos"
				}
			],
			"transformations": [
				{
					"name": "CrearCampos",
					"description": "Crear campos de la tabla de Replicacion"
				},
				{
					"name": "AlterRow1"
				},
				{
					"name": "SeleccionarColumnas"
				}
			],
			"scriptLines": [
				"source(output(",
				"          idVariedad as integer,",
				"          idProducto as integer,",
				"          Cod_Variedad as string,",
				"          Cod_Variedad1 as string,",
				"          SKU as string,",
				"          Tipo as boolean,",
				"          Nom_Variedad as string,",
				"          Nab_Variedad as string,",
				"          Pre_CostoSoles as decimal(19,4),",
				"          Pre_CostoDolares as decimal(19,4),",
				"          Pre_CostoSolesAnterior as decimal(19,4),",
				"          Pre_CostoDolaresAnterior as decimal(19,4),",
				"          Pre_CostoReposicionSoles as decimal(19,4),",
				"          Pre_CostoReposicionDolares as decimal(19,4),",
				"          Pre_VentaMinimoSoles as decimal(19,4),",
				"          Pre_VentaMinimoDolares as decimal(19,4),",
				"          Pre_VentaMinimoSolesC as decimal(19,4),",
				"          Pre_VentaMinimoDolaresC as decimal(19,4),",
				"          Pre_VentaSoles as decimal(19,4),",
				"          Pre_VentaDolares as decimal(19,4),",
				"          Pre_VentaSolesC as decimal(19,4),",
				"          Pre_VentaDolaresC as decimal(19,4),",
				"          Pre_VentaSolesEsp1 as decimal(19,4),",
				"          Pre_VentaDolaresEsp1 as decimal(19,4),",
				"          Pre_VentaSolesEsp1C as decimal(19,4),",
				"          Pre_VentaDolaresEsp1C as decimal(19,4),",
				"          Pre_VentaSolesEsp2 as decimal(19,4),",
				"          Pre_VentaDolaresEsp2 as decimal(19,4),",
				"          Pre_VentaSolesEsp2C as decimal(19,4),",
				"          Pre_VentaDolaresEsp2C as decimal(19,4),",
				"          Pre_VentaSolesEsp3 as decimal(19,4),",
				"          Pre_VentaDolaresEsp3 as decimal(19,4),",
				"          Pre_VentaSolesEsp3C as decimal(19,4),",
				"          Pre_VentaDolaresEsp3C as decimal(19,4),",
				"          Pre_VentaSolesMayor as decimal(19,4),",
				"          Pre_VentaDolaresMayor as decimal(19,4),",
				"          Pre_VentaSolesMayorC as decimal(19,4),",
				"          Pre_VentaDolaresMayorC as decimal(19,4),",
				"          Cantidad as double,",
				"          Cantidad1 as double,",
				"          Cantidad2 as double,",
				"          Cantidad3 as double,",
				"          Cantidad4 as double,",
				"          Cantidad5 as double,",
				"          Cantidad6 as double,",
				"          Cantidad7 as double,",
				"          Cantidad8 as double,",
				"          Cantidad9 as double,",
				"          Cantidad10 as double,",
				"          Cantidad11 as double,",
				"          Cantidad12 as double,",
				"          Cantidad13 as double,",
				"          Cantidad14 as double,",
				"          Cantidad15 as double,",
				"          Unidad as string,",
				"          Sto_Minimo as double,",
				"          Por_UtilidadMinimo as float,",
				"          Por_DescuentoMinimo as float,",
				"          Por_Utilidad as float,",
				"          Por_Descuento as float,",
				"          Por_UtilidadEsp1 as float,",
				"          Por_DescuentoEsp1 as float,",
				"          Por_UtilidadEsp2 as float,",
				"          Por_DescuentoEsp2 as float,",
				"          Por_UtilidadEsp3 as float,",
				"          Por_DescuentoEsp3 as float,",
				"          Por_UtilidadMayor as float,",
				"          Por_DescuentoMayor as float,",
				"          Pre_ComisionSoles as decimal(19,4),",
				"          Pre_ComisionDolares as decimal(19,4),",
				"          Por_Comision as float,",
				"          AfectoPercepcion as boolean,",
				"          Series as boolean,",
				"          IngresoValor as boolean,",
				"          Descripcion as string,",
				"          AfectoStock as boolean,",
				"          AfectoIGV as boolean,",
				"          Activo as integer,",
				"          Estado as string,",
				"          Peso as float,",
				"          Ubicacion as string,",
				"          Ubicacion1 as string,",
				"          Ubicacion2 as string,",
				"          Ubicacion3 as string,",
				"          Ubicacion4 as string,",
				"          Ubicacion5 as string,",
				"          Ubicacion6 as string,",
				"          Ubicacion7 as string,",
				"          Ubicacion8 as string,",
				"          Ubicacion9 as string,",
				"          Ubicacion10 as string,",
				"          Ubicacion11 as string,",
				"          Ubicacion12 as string,",
				"          Ubicacion13 as string,",
				"          Ubicacion14 as string,",
				"          Ubicacion15 as string,",
				"          Internet as boolean,",
				"          GarantiaPeriodo as string,",
				"          GarantiaNumero as integer,",
				"          GarantiaPorcentaje as float,",
				"          GarantiaSumPrecio as decimal(19,4),",
				"          PreciosSuperProducto as boolean,",
				"          Volumen as float,",
				"          ProductoVenta as boolean,",
				"          EnlaceWeb as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> Variedades",
				"Variedades derive(Description = Cod_Variedad + \"-\" + Nom_Variedad,",
				"          CreatedAt = currentUTC()) ~> CrearCampos",
				"CrearCampos alterRow(upsertIf(true())) ~> AlterRow1",
				"AlterRow1 select(mapColumn(",
				"          Sku = Cod_Variedad,",
				"          Name = Nom_Variedad,",
				"          Description,",
				"          Price = Pre_VentaSolesC,",
				"          Stock = Cantidad,",
				"          IsActive = Activo,",
				"          CreatedAt",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SeleccionarColumnas",
				"SeleccionarColumnas sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ProductId as integer,",
				"          Sku as string,",
				"          Name as string,",
				"          Description as string,",
				"          Price as decimal(10,2),",
				"          Stock as integer,",
				"          IsActive as boolean,",
				"          CreatedAt as timestamp",
				"     ),",
				"     deletable:false,",
				"     insertable:false,",
				"     updateable:false,",
				"     upsertable:true,",
				"     keys:['Sku'],",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          Sku,",
				"          Name,",
				"          Description,",
				"          Price,",
				"          Stock,",
				"          IsActive,",
				"          CreatedAt",
				"     )) ~> MigrarDatos"
			]
		}
	}
}